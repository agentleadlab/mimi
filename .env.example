# --- Required ---
# Discord Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=
# Discord Developer Portal → your app → General Information → Application ID
DISCORD_CLIENT_ID=
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# --- Optional ---
# Register slash commands to one server (instant) instead of globally (up to 1 hour)
DISCORD_GUILD_ID=
# Comma-separated channel IDs where Mimi answers every message, no @mention needed
MIMI_CHANNEL_IDS=
# Reply when someone says "Mimi" in a message (set to false to require an @mention)
MIMI_REPLY_TO_NAME=true

# Custom status under her name (leave empty for none)
MIMI_STATUS=💅 Always raising the standard

# Model and tuning
MIMI_MODEL=claude-opus-5
# low | medium | high | xhigh | max
MIMI_EFFORT=medium
MIMI_MAX_TOKENS=16000
MIMI_HISTORY_LIMIT=20

# --- Canva (optional) ---
# From your integration at https://www.canva.com/developers/integrations → Configuration
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Public https URL of this deployment (Railway: Settings → Networking → Generate Domain)
PUBLIC_URL=
# Where the Canva login is saved. On Railway, attach a volume at /data (used automatically).
MIMI_DATA_DIR=

# --- Ad sample library (optional) ---
# Google Sheet with columns: Sample Name, Vertical, Campaign/Context, Date Added, Loom Link, Tags
# Share it as "Anyone with the link can view". Keep this link private — it contains the Loom links.
SAMPLES_SHEET_URL=
# Minutes a client gets after pressing Watch, and days an unopened link stays valid
PREVIEW_MINUTES=15
PREVIEW_LINK_DAYS=7
# Optional "Sample Log" tab in the sheet: deploy scripts/sample-log.gs as a web app
SAMPLES_LOG_URL=
SAMPLES_LOG_SECRET=
# Name shown on the client-facing preview page
BRAND_NAME=Agent Lead Lab
